# Copy to .env. POC-level choices only — RAGFlow's own settings live in
# upstream/docker/.env after cloning (document engine, ports, passwords).
# Upstream tag to test (git tag in infiniflow/ragflow).
RAGFLOW_TAG=v0.27.2

# Document engine: elasticsearch (default) or infinity (lighter; no
# vm.max_map_count requirement). Keep elasticsearch for the main POC run.
DOC_ENGINE=elasticsearch

# Your RAGFlow API token (UI: avatar -> API -> API Key). bench.py reads this
# from the environment, do NOT commit a filled copy.
RAGFLOW_API_KEY=

# Models you configured in the UI (same as the OpenRAG POC — record for RESULTS.md):
# CHAT_MODEL=
# EMBEDDING_MODEL=
# RERANK_MODEL=
