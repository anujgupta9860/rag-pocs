# Copy to .env and fill in. .env is git-ignored — never commit a filled copy.
# Upstream tag to test (git tag in langflow-ai/openrag). Change to re-test newer.
OPENRAG_TAG=v0.3.0

# Pick ONE provider for chat + embeddings to start (same as the RAGFlow POC!).
# You can use different providers for chat vs embeddings.
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=
# AZURE_OPENAI_API_KEY=

# Models you picked (write them down — they go in RESULTS.md):
# CHAT_MODEL=
# EMBEDDING_MODEL=

# OpenSearch admin password (must meet complexity: upper+lower+digit+symbol).
# Changing it after first run requires wiping volumes (./stop.sh --wipe).
OPENSEARCH_PASSWORD=ChangeMe_123!

# Langflow superuser — REQUIRED, but you do not need to set it here:
# Langflow EXITS if LANGFLOW_SUPERUSER_PASSWORD is empty, the backend then
# dies waiting for Langflow, and the UI hangs forever on "Starting OpenRAG...".
# Leave these unset and ./start.sh generates a random password on first run,
# writes it into the upstream .env, and saves it to langflow-credentials.txt
# (git-ignored). Set them yourself only if you want a specific password.
# LANGFLOW_SUPERUSER=langflow
# LANGFLOW_SUPERUSER_PASSWORD=

# Optional port overrides if 3000/7860 clash on your Mac:
# FRONTEND_PORT=3000
# LANGFLOW_PORT=7860
# LANGFLOW_PUBLIC_URL=http://localhost:7860

# Your OpenRAG API key (created in the UI under Settings -> API keys, "orag_...").
# Not part of upstream's .env — bench.py and MCP clients read it from here/env:
OPENRAG_API_KEY=
